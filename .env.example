# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash-lite.
# GEMINI_MODEL=gemini-3.6-flash

# Optional. Sends each chat exchange to Telegram so you can see what people ask.
# Leave blank and chats are only written to the platform log.
#   1. Message @BotFather, send /newbot, copy the token
#   2. Message your new bot once, then open:
#      https://api.telegram.org/bot<TOKEN>/getUpdates  and copy result[0].message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
